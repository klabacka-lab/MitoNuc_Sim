mutationEffect(m2) {
	K = sim.getValue("K");
	mutPos = mut.position;
	
	Mutations = individual.uniqueMutations[individual.uniqueMutations.position % 10000 == mutPos % 10000];
	nucMut = Mutations[Mutations.mutationType == m1 | Mutations.mutationType == m4];
	nucFitness = mean(nucMut.selectionCoeff);
	mitoFitness = mut.selectionCoeff;
	if (isNULL(nucFitness)) {
		return 1.0 + mitoFitness;}
	
	
	if (nucFitness * mitoFitness > 0) {coopCoef = 1;}
	else {coopCoef = -1;}
	compatability = (abs(nucFitness) + abs(mitoFitness))/2;
	
	
	return 1.0 + (coopCoef*compatability);}
	
