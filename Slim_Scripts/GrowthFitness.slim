initialize() {
	
	if (!exists("asexual")){
		//parameter to toggle asexual reproduction
		defineConstant("asexual", T);
	}
	defineConstant("popSize", 100);

	//Enable pedigree tracking
	initializeSLiMOptions(keepPedigrees=T);
	
	
	//Mutations: experiment with DFE (manual section 26.11)
	
	//create normal mutation distributions
	//I just added the basic set that remains active the whole time
	initializeMutationType("m2", 0.5, "f", 0.0); // synonymous
	initializeMutationType("m3", 0.1, "g", -0.03, 0.2); // deleterious
	initializeMutationType("m5", 0.7, "g", -0.19, 1.2); // fun deleterious for preloading
	initializeMutationType("m4", 0.1, "e", 0.0); //beneficial
	
	//genomic elements
	//mito
	initializeGenomicElementType("g1",c(m2, m3, m4) , c(1,1,1));
	//autosomal
	initializeGenomicElementType("g2",c(m2, m3, m4) , c(1,1,1));
	
	
	//chromosome 1: mitochondrial chromosome
	initializeChromosome(1, type="H");
	initializeGenomicElement(g1, 0, 1e4-1);
	initializeMutationRate(1e-5);
	//SHould mitochindria recombine?
	//initializeRecombinationRate(1e-7);
	
	//chromosome 2: autosome
	initializeChromosome(2, type="A");
	initializeGenomicElement(g2, 0, 1e5-1);
	initializeMutationRate(1e-7);
	initializeRecombinationRate(1e-7);
	
	//chromosome 3: autosome
	initializeChromosome(3, type="A");
	initializeGenomicElement(g2, 0, 1e5-1);
	initializeMutationRate(1e-7);
	initializeRecombinationRate(1e-7);

}

modifyChild() {
	print("A procreation event occurred.");
	childIDs = child.haplosomes.mutations.id;

	p1IDs = parent1.haplosomes.mutations.id;
	p2IDs = (isNULL(parent2) ? integer(0) else parent2.haplosomes.mutations.id);
	inheritedPool = unique(c(p1IDs, p2IDs));


	print("");
	print("Parent 1 mutations: " + asString(p1IDs));
	print("");
	print("Parent 2 mutations: " + asString(p2IDs));
	print("");
	print("Child mutations: " + asString(childIDs));
	print("");

	gained = childIDs[match(childIDs, inheritedPool) == -1];

	cat("cycle " + asString(sim.cycle) +
		" child=" + asString(child.pedigreeID) +
		" gainedNew=" + asString(size(gained)) +
		"\n");


	for (mid in gained) {
		m = sim.mutations[sim.mutations.id == mid][0];

		cat("  new mut id=" + asString(m.id) +
			" chr=" + asString(m.chromosome.id) +
			" pos=" + asString(m.position) +
			" type=" + asString(m.mutationType.id) +
			" s=" + asString(m.selectionCoeff) +
			" origin=" + asString(m.originTick) +
			"\n");
	}

    return T;
}


1 early() {
	
	//initialize population
	sim.addSubpop("p1", popSize);
	if (asexual == T){
		p1.setCloningRate(1.0);
	}
}

1 modifyChild() {
	//gather mitochondrial chromosomes
	mito_chroms = c();
	for (mito in child.haplosomes){
		if (mito.chromosome.id == 1){
			mito_chroms = c(mito_chroms, mito);
		}
	}
	//seed deleterious mutations into mitochondrial chromosomes
	mito_chroms.addNewDrawnMutation(m5, rdunif(1,0,1e4-1));
}


2 early() {
	print("Mean fitness at generation 1:");
	print(mean(p1.cachedFitness(NULL)));
}

2: early() {


	if (mean(p1.cachedFitness(NULL)) >= 1.0){
		//Send a message when threshold is reached
		print("Mean fitness at generation " + sim.cycle + " has reached 1.0");
		print("Mean fitness at generation " + sim.cycle + ":");
		print(mean(p1.cachedFitness(NULL)));
		
		if (asexual == T){
			writeFile(getwd() + "/asexual_cycles_to_escape.txt", asString(sim.cycle), append=T);
		} else {
			writeFile(getwd() + "/sexual_cycles_to_escape.txt", asString(sim.cycle), append=T);
		}
		
		//deregister this script block to stop this check print
		community.deregisterScriptBlock(self);
	}}

