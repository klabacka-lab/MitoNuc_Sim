1 early() {

	sim.addSubpop("p1", 100);
	
	log = community.createLogFile("Capstone Project/R/sim_log_ASex.csv", logInterval=25);
	log.addCycle();
	log.addCustomColumn("Fitness", "mean(p1.cachedFitness(NULL));"); 
	p1.setCloningRate(1.0);

}
1: early() {if (sim.cycle%100 == 0) {cat(sim.cycle + "\n");}} 




1: late() {
	inds = sim.subpopulations.individuals;
	popFitt = c();
	for (ind in inds) {
		globalFitness = 0;
		unique = ind.uniqueMutations;
		uniqueNuc = unique[unique.mutationType == m1 | unique.mutationType == m2];
		uniqueMito = unique[unique.mutationType == m3 | unique.mutationType == m4];
		for (m in uniqueMito) 
		{total = 0;
			for (n in uniqueNuc[uniqueNuc.position % 250 == m.position % 250]) {
				if (n.mutationType == m1) {total = total + abs(n.selectionCoeff);}
				else {total = total - abs(n.selectionCoeff);}
			}
				
				
			
				globalFitness = globalFitness + (m.selectionCoeff * abs(m.selectionCoeff));
			if (m.mutationType == m4) 
				{globalFitness = globalFitness - (total * abs(m.selectionCoeff));}
			else 
				{globalFitness = globalFitness + (total * abs(m.selectionCoeff));}
		}
		
		for (mut in uniqueNuc) 
		{globalFitness = globalFitness + (abs(mut.selectionCoeff) * mut.selectionCoeff);}
		
		Fitness = 2*dnorm(30 - asFloat(globalFitness), 0.0, 25.0)/dnorm(0.0,0.0,25.0);
		popFitt = c(popFitt, Fitness);
	}
		
		
		inds.fitnessScaling = popFitt;
	
	}


mutationEffect(m2) {
return 1.0;}

mutationEffect(m1) {
return 1.0;}

mutationEffect(m3) {
return 1.0;}

mutationEffect(m4) {
return 1.0;}

